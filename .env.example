# Copy this file to .env and edit it. .env is never committed.

# ---- Where your data lives (outside this Git folder, inside OneDrive) ----
DATA_DIR=C:\Users\Elish\OneDrive\DrillData
# Automatic database snapshots kept in DATA_DIR\backups
BACKUP_KEEP=30

# ---- Qwen via Ollama — the default AI, works offline ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# 8192: the whole model stays on the 8 GB GPU (100% GPU). 16384 ran 12% on the CPU.
OLLAMA_NUM_CTX=8192

# ---- Claude when online — through the official Claude Code program, no API key ----
# on  = use `claude -p` when online, Qwen otherwise
# off = Qwen only
CLAUDE_CLI=on
CLAUDE_CLI_PATH=claude
# Optional: CLAUDE_MODEL=sonnet (empty = Claude Code's default), CLAUDE_TIMEOUT=600,
# OLLAMA_TIMEOUT=900. See docs/API.md.

# ---- Local server ----
PORT=8765

# ---- Phone access (Phase 8) — the phone uses this PC's Drill over Tailscale ----
# off = this PC only (default). on = also Tailscale devices, which must enter the PIN
# (set it on the PC first: python -m server.pin set). See docs/API.md "Phone access".
PHONE_ACCESS=off
# on = also allow devices on the home Wi-Fi (private addresses), still with the PIN
PHONE_ALLOW_LAN=off
# Extra names the phone may use for this PC, comma-separated (Tailscale IP and MagicDNS
# name are detected automatically), e.g. PHONE_HOSTS=drill-pc.tail1234.ts.net
PHONE_HOSTS=

# ---- Sign-in (Phase 9) — Google accounts, one database per person ----
# off    = no sign-in (as before)
# google = everyone signs in with an approved Google account; sessions last 7 days, offline too.
#          Needs the two values below from the Google Cloud Console (see docs/API.md "Sign-in").
#          Approve accounts with: python -m server.accounts allow <email> [--existing-data]
AUTH_MODE=off
# Never commit these; they belong in .env only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
